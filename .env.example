# Copy this file to .env for local development. Never commit .env.
# Use the Client ID and client secret from the same GitHub App as production.
# That app must include this exact callback URL:
# http://127.0.0.1:5173/api/auth/github/callback
GITHUB_CLIENT_ID="Iv1.example"
GITHUB_CLIENT_SECRET="replace-with-the-github-app-client-secret"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-random-characters"
