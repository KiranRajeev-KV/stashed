{
  "name": "stashed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply stashed-db --local",
    "db:seed": "node ./scripts/seed.mjs",
    "db:backfill-content-plain": "node --experimental-strip-types ./scripts/backfill-idea-content-plain.ts",
    "db:remote": "wrangler d1 migrations apply stashed-db --remote"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/code-block": "53.0.0",
    "@platejs/indent": "53.0.0",
    "@platejs/link": "53.3.5",
    "@platejs/list": "53.1.3",
    "@platejs/markdown": "53.3.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-devtools": "^1.167.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "platejs": "53.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sonner": "^2.0.8",
    "unified": "11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
